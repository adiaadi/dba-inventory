          {
            "uuid": "b157cfd0fe765653b6f651ec940c895e",
            "name": "Patroni: nodes reported running or streaming",
            "type": "DEPENDENT",
            "key": "db.replication.patroni.healthy_nodes",
            "value_type": "UNSIGNED",
            "history": "7d",
            "trends": "30d",
            "master_item": {
              "key": "db.replication.patroni.raw"
            },
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); return d.members.filter(function(m){return m.state===\"running\" || m.state===\"streaming\";}).length;"
                ]
              }
            ],
            "triggers": [
              {
                "uuid": "c8425f22256b5eb4826c1f310b4c9570",
                "name": "Patroni: fewer running/streaming nodes than expected",
