          {
            "uuid": "40b4b857142f530e82f1ad385d9170f0",
            "name": "Patroni: cluster snapshot",
            "type": "HTTP_AGENT",
            "key": "db.replication.patroni.raw",
            "url": "{$PATRONI.URL}/cluster",
            "delay": "30s",
            "timeout": "10s",
            "value_type": "TEXT",
            "history": "1d",
            "trends": "0",
            "description": "Cluster topology from Patroni REST API. The endpoint is a monitoring source, not a fixed leader.",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); if(d.scope!==\"{$PATRONI.SCOPE}\" || !Array.isArray(d.members)) throw \"Unexpected Patroni cluster\"; return JSON.stringify(d);"
                ]
              }
            ],
            "triggers": [
              {
                "uuid": "6c41384b7598551daf8812792f964f98",
                "name": "Patroni: no cluster data for 3 minutes",
                "expression": "nodata(/DB Inventory Patroni cluster HTTP/db.replication.patroni.raw,3m)=1",
                "priority": "HIGH"
              }
            ]
          },
          {
            "uuid": "7ff6339f38e55251aea1f9289df0fb42",
            "name": "Patroni: cluster name",
            "type": "DEPENDENT",
            "key": "db.replication.patroni.scope",
            "value_type": "TEXT",
            "history": "7d",
            "trends": "0",
            "master_item": {
              "key": "db.replication.patroni.raw"
            },
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); return d.scope;"
                ]
              }
            ]
          },
          {
            "uuid": "a54f6ebe2b6c5b458af0250e9a3bce74",
            "name": "Patroni: current leader",
            "type": "DEPENDENT",
            "key": "db.replication.patroni.leader",
            "value_type": "TEXT",
            "history": "7d",
            "trends": "0",
            "master_item": {
              "key": "db.replication.patroni.raw"
            },
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); var a=d.members.filter(function(m){return m.role===\"leader\";}); if(a.length!==1) throw \"Expected exactly one leader\"; return a[0].name;"
                ]
              }
            ]
          },
          {
            "uuid": "685b25d4cc21588b9067f99b44e4979e",
            "name": "Patroni: leader count",
            "type": "DEPENDENT",
            "key": "db.replication.patroni.leader_count",
            "value_type": "UNSIGNED",
            "history": "7d",
            "trends": "30d",
            "master_item": {
              "key": "db.replication.patroni.raw"
            },
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); return d.members.filter(function(m){return m.role===\"leader\";}).length;"
                ]
              }
            ],
            "triggers": [
              {
                "uuid": "1cc62b1be47259449ac9f7e15b8ba550",
                "name": "Patroni: expected exactly one leader",
                "expression": "last(/DB Inventory Patroni cluster HTTP/db.replication.patroni.leader_count)<>1",
                "priority": "HIGH"
              }
            ]
          },
          {
            "uuid": "fbcf3886f3c25e8381df087326b0e5a1",
            "name": "Patroni: reported member count",
            "type": "DEPENDENT",
            "key": "db.replication.patroni.members",
            "value_type": "UNSIGNED",
            "history": "7d",
            "trends": "30d",
