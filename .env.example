DATABASE_URL=postgresql+psycopg://dba_inventory:dba_inventory@localhost:5432/dba_inventory
APP_NAME=DBA Inventory
APP_ENV=local
APP_TIMEZONE=Asia/Almaty
SESSION_SECRET=change-this-session-secret
SESSION_COOKIE_SECURE=true
PORTAL_USERNAME=inventory
PORTAL_PASSWORD=change-this-portal-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ZABBIX_URL=https://zabbix.example.local
ZABBIX_API_TOKEN=replace-with-zabbix-api-token
ZABBIX_VERIFY_SSL=true
ZABBIX_CA_FILE=
ZABBIX_AUTO_REFRESH_SECONDS=300
ZABBIX_CA_FILE_HOST=
ZABBIX_HOSTNAME=zabbix.example.local
ZABBIX_IP=10.0.0.10
HTTP_PORT=80
HTTPS_PORT=443
PFX_FILE=./certs/db-inv.bnkc.com.pfx
PFX_PASSWORD=
TLS_CERT_FILE_HOST=./certs/db-inv.bnkc.com.crt
TLS_KEY_FILE_HOST=./certs/db-inv.bnkc.com.key
